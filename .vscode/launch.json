{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit: Debug",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "main.py",
        "--server.address=0.0.0.0",
        "--server.port=8501",
        "--server.headless=true"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
